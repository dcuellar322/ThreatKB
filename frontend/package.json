{
  "name": "threatkb-workbench",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "format": "prettier --write src vite.config.ts ../detections ../.github/workflows ../docker-compose.yml ../package.json",
    "format:check": "prettier --check src vite.config.ts ../detections ../.github/workflows ../docker-compose.yml ../package.json",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.12.4",
    "@codemirror/legacy-modes": "6.5.4",
    "@codemirror/merge": "6.12.2",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@lezer/highlight": "1.2.5",
    "codemirror": "6.0.2",
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "nanoid": "3.3.19",
    "postcss": "8.5.28",
    "@lezer/lr": "1.4.10"
  }
}
