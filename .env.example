# Copy to .env and replace these placeholders. Do not commit .env.
# Keep SQL_PASSWORD raw; percent-encode its value only inside the native URL below.
# Quote shell-sensitive values because native launchers also source this file.
MYSQL_ROOT_PASSWORD=replace-with-a-local-root-password
SQL_PASSWORD=replace-with-an-app-database-password
THREATKB_SECRET_KEY=replace-with-a-long-random-value
THREATKB_ADMIN_EMAIL=you@example.com
# Set for first-time unattended bootstrap; remove after creating the administrator.
THREATKB_ADMIN_PASSWORD=
# Compose defaults; override to run an isolated second stack.
WEB_PORT=5080
MYSQL_PORT=3307
REDIS_PORT=6380
# Native web/worker/scheduler also load .env. Adjust these for your local services.
THREATKB_DATABASE_URL=mysql+pymysql://threatkb:replace-with-an-app-database-password@127.0.0.1:3307/threatkb?charset=utf8mb4
REDIS_BROKER_URL=redis://127.0.0.1:6380/0
# Optional: CONTENT_REPOSITORY and THREATKB_INSTANCE_PATH must be absolute paths.
